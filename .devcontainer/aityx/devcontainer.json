{
  // ---------------------------------------------------------------------
  // aityx demos
  //
  // The aityx group, started together: Mortgage Hub, Contact Hub,
  // Cellfie, RoboRules, RiverRace and PokerFace, each a Flutter web app
  // that calls aityx.ai from the browser, all served by the index
  // (Index/) on one port, 8800, at /mortgagehub/, /contacthub/, ...: the
  // folders whose group.id.txt says aityx. Each user sets their own aityx
  // key once on the index page, and every demo uses it.
  //
  // Source:  https://github.com/aityx-labs/aityx-demos
  // Rules:   https://aityx.ai — runs every decision in every demo
  // Aletyx:  https://aletyx.com
  //          https://nu01.com
  //
  // One dev container per demo group: this one, and the datyx group's in
  // .devcontainer/datyx/. Each has its own image. The scripts they run
  // are shared, in .devcontainer/, and act on the group DEMOS_GROUP names.
  // The name below is what GitHub shows in the "Dev container
  // configuration" list when you create a codespace.
  // ---------------------------------------------------------------------
  "name": "aityx demos",
  // The group's published image (image/Containerfile, built and pushed by
  // `bash image/build-image.sh aityx`): Flutter, the GitHub CLI,
  // process-compose and each aityx demo's release web build, so nothing is
  // built when a codespace is created and the demos start in seconds. The organization has
  // GitHub's prebuilds switched off; this is the next best thing.
  "image": "docker.io/aletyxcode/samples-and-demos-aityx:latest",
  "remoteUser": "vscode",
  // An SSH server, so `gh codespace ssh`, `gh codespace cp` and
  // `gh codespace logs` reach the codespace from a terminal: that is how
  // startup.log is read without the editor, and how the demos are
  // benchmarked. No Docker: no aityx demo has a database.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // The 4-core, 16 GB Codespaces machine. The published image carries
  // the builds, so creating a codespace pulls it and starts the demos; a
  // demo that changed since the image was made builds itself (a minute).
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  // The index server must listen on every interface for the forwarded
  // port to reach it (only the container sees it). It serves the six
  // apps too: they have no servers of their own.
  "containerEnv": {
    // The demos run on the image's Flutter and process-compose, not devbox
    // (see demos-toolchain.sh).
    "DEMOS_TOOLCHAIN": "image",
    // The group: ./start-all.sh, ./stop-all.sh and ./build-all.sh act on
    // its folders only, and the dev container scripts start it.
    "DEMOS_GROUP": "aityx",
    "INDEX_BIND_HOST": "0.0.0.0"
  },
  // Optional. Each user sets their own aityx key on the index page
  // ("Your aityx key"), kept in their browser, and every demo uses it.
  // With an AITYX_API_KEY secret, your own key, never the repository's,
  // the index server has a dev key: it lends it, through its own proxy
  // (the key never reaches a browser), to every visitor of your codespace
  // who has not set a key of their own. GitHub offers the secrets when you
  // create a codespace, stores them against your account, and passes them
  // to the container as environment variables, which the index server
  // reads before falling back to the root .env. Change them at
  // https://github.com/settings/codespaces.
  //
  // AITYX_URL is optional too: the dev key's endpoint, by default
  // https://api.aityx.ai.
  "secrets": {
    "AITYX_API_KEY": {
      "description": "Optional. Your own aityx.ai API key, from the console's API keys page: a dev key every visitor of your codespace uses unless they set their own on the index page.",
      "documentationUrl": "https://aityx.ai/docs"
    },
    "AITYX_URL": {
      "description": "Optional. The dev key's API endpoint; leave unset for https://api.aityx.ai."
    }
  },
  // The image's flutter and dart on the PATH of every terminal.
  // ${containerEnv:PATH} is the image's own PATH.
  "remoteEnv": {
    "PATH": "/opt/flutter/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // The Flutter SDK in the image (see image/Containerfile), there
        // from the moment VS Code attaches, so the Dart extension doesn't
        // offer to download one.
        "dart.flutterSdkPath": "/opt/flutter",
        // No `pub get` from the editor, prompted or on a pubspec change: it
        // rewrites each app's pubspec.lock, which makes the image's builds
        // look older than the apps, so every demo rebuilds instead of
        // starting in seconds.
        "dart.promptToGetPackages": false,
        "dart.runPubGetOnPubspecChanges": "never"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  // The index page, which serves the six apps too, at /mortgagehub/,
  // /contacthub/, ... on the same port: one origin, so a key set on the
  // index page reaches every app. Plain HTTP, which is what the server
  // speaks; switching a public port to HTTPS makes it private.
  // post-start.sh makes it public, which devcontainer.json cannot. It
  // opens a browser tab: it is up in seconds and shows the demos while
  // any of them still builds.
  "forwardPorts": [8800],
  "portsAttributes": {
    "8800": {
      "label": "Index: the six aityx demos on one page",
      "protocol": "http",
      "onAutoForward": "openBrowserOnce"
    }
  },
  // All run from the repository root, in this order, when the codespace
  // is created; the editor attaches after the first (waitFor), while any
  // build goes on in the background with its progress in startup.log.
  // (The first two are also what a Codespaces prebuild would snapshot,
  // were prebuilds allowed for the organization.)
  //   on-create.sh       the image's release web builds into the workspace
  //                      (image/restore-builds.sh)
  //   update-content.sh  ./build-all.sh: each of the group's release web
  //                      builds, only what changed
  //   post-create.sh     whether the optional aityx secrets arrived
  // post-start.sh starts the index with ./start-all.sh (which builds what
  // is stale first) and makes its port public on every start.
  "onCreateCommand": "bash -lc 'bash .devcontainer/on-create.sh'",
  "updateContentCommand": "bash -lc 'bash .devcontainer/update-content.sh'",
  "postCreateCommand": "bash -lc 'bash .devcontainer/post-create.sh'",
  "waitFor": "onCreateCommand",
  "postStartCommand": "bash -lc 'bash .devcontainer/post-start.sh'",
  // Again each time VS Code attaches: a visibility set at start does not
  // always stick, and users report it does from here.
  "postAttachCommand": "bash .devcontainer/public-port.sh"
}

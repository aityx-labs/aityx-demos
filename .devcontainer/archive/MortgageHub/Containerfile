FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

SHELL ["/bin/bash", "-lc"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        lsof \
        sudo \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Devbox: the pinned release's binary straight from GitHub, checked against
# its published SHA-256 (the release's checksums.txt) for this
# architecture, rather than piping get.jetify.com's installer (which
# fetches an unpinned launcher) into bash.
ARG DEVBOX_VERSION=0.18.1
ARG DEVBOX_SHA256_AMD64=e05382153512fcd9df3224e847cef678afc7c9c5918863dfc2048eb9ecea9df4
ARG DEVBOX_SHA256_ARM64=9259051516638ed0487c95c56e28c36ab715762739b01423ffa8aae9e7f9ad89
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) sha="$DEVBOX_SHA256_AMD64" ;; \
         arm64) sha="$DEVBOX_SHA256_ARM64" ;; \
         *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/devbox.tar.gz \
         "https://github.com/jetify-com/devbox/releases/download/${DEVBOX_VERSION}/devbox_${DEVBOX_VERSION}_linux_${arch}.tar.gz" \
    && echo "${sha}  /tmp/devbox.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/devbox.tar.gz -C /usr/local/bin devbox \
    && chown root:root /usr/local/bin/devbox \
    && chmod 755 /usr/local/bin/devbox \
    && rm /tmp/devbox.tar.gz \
    && devbox version

# GitHub CLI, which public-port.sh uses to make the web app's port public
# in a codespace. The pinned release, checked against its checksums.txt.
ARG GH_VERSION=2.102.0
ARG GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
ARG GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) sha="$GH_SHA256_AMD64" ;; \
         arm64) sha="$GH_SHA256_ARM64" ;; \
         *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/gh.tar.gz \
         "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
    && echo "${sha}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && install -o root -g root -m 755 "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${arch}" \
    && gh --version

# Flutter, in the image so the Dart and Flutter extensions find an SDK the
# moment VS Code attaches, instead of asking to download one while
# post-create.sh is still filling the Nix store. The same version as
# devbox.lock's flutter, so the editor and `devbox services up` agree.
# Owned by vscode, because flutter writes its own cache under bin/cache.
# x64: the release archive, checked against the SHA-256 published in
# releases_linux.json. Flutter publishes no Linux arm64 archive, so there
# (a local dev container on Apple silicon) it is the release tag from git.
ARG FLUTTER_VERSION=3.47.0
ARG FLUTTER_SHA256_AMD64=26cd99d3d94b1367e6b50535a18aeef0282c10a535bbe3ec493534dcdab75296
RUN install -d -o vscode -g vscode /opt/flutter
USER vscode
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) \
           curl -fsSL -o /tmp/flutter.tar.xz \
             "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
           && echo "${FLUTTER_SHA256_AMD64}  /tmp/flutter.tar.xz" | sha256sum -c - \
           && tar -xJf /tmp/flutter.tar.xz -C /opt/flutter --strip-components=1 \
           && rm /tmp/flutter.tar.xz ;; \
         arm64) \
           git clone --depth 1 --branch "$FLUTTER_VERSION" \
             https://github.com/flutter/flutter.git /opt/flutter ;; \
         *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
       esac \
    && /opt/flutter/bin/flutter config --no-analytics --no-cli-animations \
    && /opt/flutter/bin/flutter --disable-analytics \
    && /opt/flutter/bin/flutter precache --web \
    && /opt/flutter/bin/flutter --version
ENV PATH="/opt/flutter/bin:${PATH}"

# Install packages as the runtime user so the nix profile ownership matches

# Devbox needs Nix. Install it single-user (--no-daemon): containers have no
# systemd for the nix daemon, and this way the store is owned by vscode.
# A pinned release, with its installer checked against the published hash.
ARG NIX_VERSION=2.35.0
ARG NIX_INSTALL_SHA256=78142338c3a78fe1b58f56ebcadbe7bbd22f9a304b954daff53c5d14608771f0
RUN curl -fsSL -o /tmp/nix-install "https://releases.nixos.org/nix/nix-${NIX_VERSION}/install" \
    && echo "${NIX_INSTALL_SHA256}  /tmp/nix-install" | sha256sum -c - \
    && sh /tmp/nix-install --no-daemon \
    && rm /tmp/nix-install

# The Nix store is filled after the container starts (post-create.sh), not
# here (Flutter above is the exception, for the editor): a 10 GB image layer only slows the build, Codespaces rebuild the
# image for each codespace anyway, and a failure there leaves a codespace
# with a terminal instead of recovery mode.
# No WORKDIR: this repository holds several samples, so the checkout path
# depends on the repository name (/workspaces/<repo>). The dev container
# opens the repository root and post-create.sh moves to MortgageHub/.

# Local settings. Copy this to .env (gitignored) and fill it in. Optional:
# each user of the aityx demos sets their own key on the index page
# ("Your aityx key"), kept in their browser.

# Local development runs on aityx staging (https://stage.aityx.ai): its
# key, from https://console-stage.aityx.ai, and its API,
# https://api-stage.aityx.ai. Production (what gets deployed) runs on
# https://api.aityx.ai with production's key: AITYX_PROD_* below, which
# only deploy scripts read; the deployed and published demos never get
# a key from here and default to production.

# aityx (https://aityx.ai/docs): staging's API key. A secret. Here it is
# the dev key:
# the index server (Index/) reads this file itself and lends the key,
# through its own proxy, never to a browser, to anyone who opens the
# demos without a key of their own; and each demo's scripts/model-test.sh
# runs its aityx-tagged tests with it. The datyx group's HealthHub reads
# it too (start-all.sh links HealthHub/.env to this file), and so does
# datyx's API, for its aityx gateway, when datyx/.env has none.
AITYX_API_KEY=
# The API's base URL: staging's, for local development. Empty:
# https://api.aityx.ai, production's, which a staging key doesn't work on.
AITYX_URL=https://api-stage.aityx.ai
# Production: the API and the key deploys give the deployed demos
# (PokerTour/deploy/deploy.sh). Never read by local runs. The key is a
# secret, from https://console.aityx.ai.
AITYX_PROD_URL=https://api.aityx.ai
AITYX_PROD_API_KEY=

# Poker Tour's leaderboard keys: they play the tournaments on the server
# and never reach a browser (players set their own keys in the app).
# Staging (local), else AITYX_API_KEY:
POKERTOUR_LEADERBOARD_KEY=
# Production (PokerTour/deploy/deploy.sh puts it in S3):
POKERTOUR_PROD_LEADERBOARD_KEY=
# The token HealthHub presents to datyx's aityx gateway, and datyx
# checks: a secret both read from here (openssl rand -hex 32). Empty:
# HealthHub calls aityx directly with the key above.
DATYX_SERVICE_TOKEN=

# Local settings for every demo. Copy this to .env (gitignored) and fill it
# in. start-all.sh links each demo's .env to this one (<demo>/.env ->
# ../.env), so process-compose and the demos' scripts all load it.

# aityx.ai (https://stage.aityx.ai/docs): the API key, from the console's
# API keys page. A secret: only the demos' APIs and scripts read it, never
# their Flutter apps.
AITYX_API_KEY=
# The API's base URL. Empty: https://api.aityx.ai, the one the docs name.
# A stage key (from https://console-stage.aityx.ai) works only on stage:
# AITYX_URL=https://api-stage.aityx.ai
AITYX_URL=

# Local settings. Copy this to .env (gitignored) and fill it in. In a
# codespace the key comes from your Codespaces secret instead. Every value
# but the key has a default; the scripts read these from the environment
# first, then from this file (see scripts/env.sh).

# aityx.ai (https://aityx.ai/docs): the API key, from the console's API
# keys page; the same key as Mortgage Hub's and Contact Hub's. A secret:
# only the API reads it, and it must never reach the Flutter app (anything
# compiled in is readable in the web bundle). It triages each admission
# (docs/aityx.md).
AITYX_API_KEY=
# The API's base URL. Empty: https://api.aityx.ai, the one the docs name.
# Local development runs on staging, with a stage key (from
# https://console-stage.aityx.ai), which works only there:
AITYX_URL=https://api-stage.aityx.ai
# Triage at the desk (docs/aityx.md): each admission triaged by aityx from
# what the patient says, one call each. Empty or on: on whenever the key is
# set (or calls go through datyx, below); off: no triage.
HEALTHHUB_TRIAGE=
# The triage's calls through datyx's aityx gateway (datyx's
# specs/aityx.md), which calls aityx with datyx's key and accounts for
# every call in the dashboard's aityx tab: on or off; empty: on in dev
# mode, off in prod. Only with DATYX_SERVICE_TOKEN; when datyx can't pass
# a call on, HealthHub calls aityx directly with AITYX_API_KEY.
HEALTHHUB_AITYX_VIA_DATYX=
# The token HealthHub presents to datyx's gateway instead of a key: a
# secret, the same as datyx's DATYX_SERVICE_TOKEN (openssl rand -hex 32).
# In development both read it from the repository root's .env.
DATYX_SERVICE_TOKEN=

# Where the services listen. 127.0.0.1 keeps them to this machine; set
# 0.0.0.0 to share them (a codespace or a shared dev box).
HEALTHHUB_BIND_HOST=127.0.0.1

# Ports: HealthHub takes 9801 to 9806, the 98xx range after the datyx
# index (9800), apart from the other demos (88xx and 89xx) and datyx
# (99xx).
# FLUTTER_WEB_PORT and API_PORT are the names every demo and the
# repository's start-all.sh use.
FLUTTER_WEB_PORT=9801           # the web app, at /app/
API_PORT=9802                   # the API (healthhub_api/)
HEALTHHUB_DB_PORT=9803          # PostgreSQL, published by compose.yaml
HEALTHHUB_KAFKA_PORT=9804       # Kafka, published by compose.yaml (advertised as localhost)
HEALTHHUB_KAFKA_REST_PORT=9805  # Kafka's REST proxy (Karapace), published by compose.yaml
HEALTHHUB_FLINK_PORT=9806       # Flink's web UI and REST API, published by compose.yaml (always 127.0.0.1)

# PostgreSQL. Development passwords; change them anywhere shared. The API
# connects as the healthhub user to the healthhub database.
HEALTHHUB_DB_ADMIN_PASSWORD=postgres    # the postgres superuser
HEALTHHUB_DB_PASSWORD=healthhub         # the healthhub user, owner of the healthhub database

# How `devbox services up` serves the web app (scripts/flutter-web.sh):
#   release the release web build, served by a small native server (built when stale)
#   debug   Flutter's dev server with hot reload (`devbox run web` does this)
WEB_MODE=release

# Authentication: OpenID Connect, Google first. Empty: off, every call is
# anonymous. With the client id of the Google OAuth client named healthhub
# (Google Cloud project healthhub, APIs & Services > Credentials; a Web
# application client with http://localhost:9801 among its authorized
# JavaScript origins), the app signs in with Google (it reads the id from
# GET /api/auth/config, so nothing is built in) and the API verifies the
# ID token on every call. The user's token also goes on to the datyx API
# (/api/datyx/*), which must list this client id in its
# OIDC_EXTRA_AUDIENCES to see the same person.
OIDC_CLIENT_ID=
OIDC_ISSUER=https://accounts.google.com
# The datyx API, for /api/datyx/*. Empty: http://127.0.0.1:9900.
DATYX_API_URL=

# The mode: dev runs the people simulation (people moving between their
# homes and the nearest hospital, streamed through Kafka and shown on the
# map); prod runs neither the simulation nor its consumer.
HEALTHHUB_MODE=dev
# Where the API reaches Kafka's REST proxy. Empty: the published port,
# http://127.0.0.1:9805 (compose.yaml sets http://kafka-rest:8082 for its
# own api service).
HEALTHHUB_KAFKA_REST_URL=
# The simulation: people per city, real milliseconds per turn, and
# simulated minutes per turn (2500 and 15: a simulated hour every 10 real
# seconds, slow enough for datyx's forecast, about 7 s a call, to come
# within a simulated hour and warn minutes ahead; see specs/simulation.md).
HEALTHHUB_SIM_PEOPLE=80
HEALTHHUB_SIM_TURN_MS=2500
HEALTHHUB_SIM_MINUTES_PER_TURN=15
# In dev mode, the days of generated admissions history (the run 00000000
# of admissions_hourly) the API writes at start, for a forecast to train
# on: 90 by default, 0 for none.
HEALTHHUB_HISTORY_DAYS=90
# In dev mode, the days of the people's visits the API simulates ahead at
# start (the run 00000001 of admissions, so of the views patient_days and
# occupancy_hourly, and of admissions_hourly), for datyx's XGBoost and
# DeepAR to train on from the first start: 365 by default, 0 for none, at
# most 730 (see specs/simulated-history.md).
HEALTHHUB_SIM_HISTORY_DAYS=365
# The occupancy alarms (dev mode): real milliseconds between two checks at
# least, set off by the events panel's reads with the reader's token (5000;
# 0 turns them off), and the share of a care center's capacity whose
# reaching, observed or forecast, is an alarm (0.9, or 90%).
HEALTHHUB_ALARM_EVERY_MS=5000
HEALTHHUB_ALARM_THRESHOLD=0.9

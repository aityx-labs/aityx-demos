# Local settings. Copy this to .env (gitignored) and fill it in. In a
# codespace the key comes from your Codespaces secret instead. Every value
# but the key has a default; the scripts read these from the environment
# first, then from this file (see scripts/env.sh).

# aityx.ai (https://aityx.ai/docs): the API key, from the console's API
# keys page; the same key as Mortgage Hub's and Contact Hub's. A secret:
# only the API reads it, and it must never reach the Flutter app (anything
# compiled in is readable in the web bundle). Nothing calls aityx yet.
AITYX_API_KEY=
# The API's base URL. Empty: https://api.aityx.ai, the one the docs name.
# A stage key (from https://console-stage.aityx.ai) works only on stage:
# AITYX_URL=https://api-stage.aityx.ai
AITYX_URL=

# Where the services listen. 127.0.0.1 keeps them to this machine; set
# 0.0.0.0 to share them (a codespace or a shared dev box).
HEALTHHUB_BIND_HOST=127.0.0.1

# Ports: HealthHub takes 9800 to 9802, the 98xx range, apart from the
# other demos (88xx and 89xx) and datyx (99xx).
# FLUTTER_WEB_PORT and API_PORT are the names every demo and the
# repository's start-all.sh use.
FLUTTER_WEB_PORT=9800           # the web app, at /app/
API_PORT=9801                   # the API (healthhub_api/)
HEALTHHUB_DB_PORT=9802          # PostgreSQL, published by compose.yaml

# PostgreSQL. Development passwords; change them anywhere shared. The API
# connects as the healthhub user to the healthhub database.
HEALTHHUB_DB_ADMIN_PASSWORD=postgres    # the postgres superuser
HEALTHHUB_DB_PASSWORD=healthhub         # the healthhub user, owner of the healthhub database

# How `devbox services up` serves the web app (scripts/flutter-web.sh):
#   release the release web build, served by a small native server (built when stale)
#   debug   Flutter's dev server with hot reload (`devbox run web` does this)
WEB_MODE=release

# Authentication: OpenID Connect, Google first. Empty: off, every call is
# anonymous. With the client id of the Google OAuth client named healthhub
# (Google Cloud project healthhub, APIs & Services > Credentials; a Web
# application client with http://localhost:9800 among its authorized
# JavaScript origins), the app signs in with Google (it reads the id from
# GET /api/auth/config, so nothing is built in) and the API verifies the
# ID token on every call. The user's token also goes on to the datyx API
# (/api/datyx/*), which must list this client id in its
# OIDC_EXTRA_AUDIENCES to see the same person.
OIDC_CLIENT_ID=
OIDC_ISSUER=https://accounts.google.com
# The datyx API, for /api/datyx/*. Empty: http://127.0.0.1:9900.
DATYX_API_URL=

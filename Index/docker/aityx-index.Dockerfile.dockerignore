# aityx-index.Dockerfile builds from the root of the repository: only what
# the six web builds and the server need comes in, never the root .env,
# .secrets/ or a local build. A seventh demo of the aityx group needs its
# lines here and in the Dockerfile.
*
!packages/aityx_web/lib/
!packages/aityx_web/pubspec.yaml
!Index/bin/
!Index/www/
!Index/group.id.txt
!Cellfie/group.id.txt
!Cellfie/version.?.txt
!Cellfie/scripts/
!Cellfie/cellfie_app/
!ContactHub/group.id.txt
!ContactHub/version.?.txt
!ContactHub/scripts/
!ContactHub/contacthub_app/
!MortgageHub/group.id.txt
!MortgageHub/version.?.txt
!MortgageHub/scripts/
!MortgageHub/mortgagehub_app/
!PokerFace/group.id.txt
!PokerFace/version.?.txt
!PokerFace/scripts/
!PokerFace/pokerface_app/
!RiverRace/group.id.txt
!RiverRace/version.?.txt
!RiverRace/scripts/
!RiverRace/riverrace_app/
!RoboRules/group.id.txt
!RoboRules/version.?.txt
!RoboRules/scripts/
!RoboRules/roborules_app/
# The apps' other platforms and their tests: a web build reads none of
# them.
*/*_app/android/
*/*_app/ios/
*/*_app/linux/
*/*_app/test/
# What the apps' own .gitignore files leave out by anchored rules, which
# the generated block below doesn't carry over to a context at the root
# (it keeps their unanchored rules only): a test coverage report, and
# RoboRules' local dev server settings.
*/*_app/coverage/
*/*_app/web_dev_config.yaml


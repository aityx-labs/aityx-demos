# Local settings. Put the aityx ones in the repository's root .env (see
# ../.env.example): start-all.sh links this folder's .env to it. A real file
# here instead is read the same way, for settings of this demo only
# (ASSUMED_RATE, below).

# aityx.ai (https://stage.aityx.ai/docs): the API key, from the console's
# API keys page. A secret: only scripts and a future backend use it, and it
# must never reach the Flutter app (anything compiled in is readable in
# the web bundle). Check it with `bash scripts/aityx-check.sh`.
AITYX_API_KEY=
# The API's base URL. Empty: https://api.aityx.ai, the one the docs name.
# A stage key (from https://console-stage.aityx.ai) works only on stage:
# AITYX_URL=https://api-stage.aityx.ai
AITYX_URL=
# The regulatory check's payment estimate: the annual rate in percent.
# Empty: 6.5.
ASSUMED_RATE=

# Local settings. Copy this to .env (gitignored) and fill it in; in the
# repository, start-all.sh links this folder's .env to the root one. The
# scripts read these from the environment first, then from this file
# (scripts/env.sh). Every value but the key and the sign-in has a default.

# aityx.ai (https://aityx.ai/docs): the leaderboard's key, from the
# console's API keys page, which plays the tournaments and checks entries.
# A secret: only the server reads it, and it never reaches a browser;
# players bring their own keys, set in the app's Profile and kept in
# their browser. POKERTOUR_LEADERBOARD_KEY is Poker Tour's own; else
# AITYX_API_KEY, the repository's shared staging key.
POKERTOUR_LEADERBOARD_KEY=
AITYX_API_KEY=
# aityx's base URL, for the server and the browsers alike: staging's in
# local development (with staging's key above). Empty:
# https://api.aityx.ai.
AITYX_URL=https://api-stage.aityx.ai
# Production's aityx, for bash deploy/deploy.sh only: the deployed app and
# functions use this address, and the leaderboard's production key goes to
# the data bucket's pokertour/leaderboard.key, which only the functions can
# read: never to a function's environment, a parameter or a command line.
AITYX_PROD_URL=https://api.aityx.ai
POKERTOUR_PROD_LEADERBOARD_KEY=

# The sign-in: Google, through OpenID Connect. The client id of a Web
# application OAuth client (Google Cloud, APIs & Services > Credentials)
# whose authorized JavaScript origins list the app's address
# (http://localhost:9810, and wherever it is deployed). Empty: nobody can
# sign in; the leaderboard still plays. The app reads the id from
# GET /api/config, so nothing is built in; the server verifies the ID
# token on every call that needs a player.
OIDC_CLIENT_ID=
OIDC_ISSUER=https://accounts.google.com
# Poker Tour's own client id, which wins over OIDC_CLIENT_ID: the
# repository's root .env is shared with HealthHub, whose client is in
# another Google Cloud project. The client's downloaded JSON (its secret,
# which nothing here needs) is kept in PokerTour/.secrets/, git- and
# docker-ignored.
POKERTOUR_OIDC_CLIENT_ID=
# Who may play: the email domains, comma separated.
POKERTOUR_ALLOWED_DOMAINS=aletyx.com,aletyx.ai
# The tour's admins, who can start a tournament now from the leaderboard,
# are the aletyx.com and aletyx.ai accounts: no setting.

# The leaderboard: on (the default, with a key) or off; the hours of the
# day (UTC) at which a tournament is played on its own (four times a day,
# every six hours, by default; off for none: only when an admin asks);
# the hands after which a tournament ends on chips; the strategies a
# player may have in at once; and the tournaments in 24 hours past which
# only the schedule's play (players and admins ask for the others). Every
# decision is an aityx call on the host's key: a tournament of five is a
# few hundred. A tournament gets fourteen minutes, a Lambda function's
# time, here too.
POKERTOUR_RUN=on
POKERTOUR_SCHEDULE_HOURS=0,6,12,18
POKERTOUR_MAX_HANDS=300
POKERTOUR_MAX_ENTRIES=3
POKERTOUR_MAX_DAILY_TOURNAMENTS=12

# On AWS (bash deploy/deploy.sh; see the README): the stack's name
# (default pokertour) and the functions' architecture (arm64 or x86_64).
POKERTOUR_STACK=
LAMBDA_ARCH=

# Where the server listens. 127.0.0.1 keeps it to this machine; set
# 0.0.0.0 to share it (a codespace or a shared dev box). One port, 9810,
# for the app (/app/) and its API (/api/). The multyx group's index is on
# 9700; this stays 9810, the origin the Google sign-in client allows.
POKERTOUR_BIND_HOST=127.0.0.1
FLUTTER_WEB_PORT=9810
API_PORT=9810

# Local settings. Copy this to .env (gitignored) and fill it in. Every value
# has a default; the scripts read these from the environment first, then
# from this file (see scripts/env.sh).

# Where the dashboard listens. 127.0.0.1 keeps it to this machine; set
# 0.0.0.0 to share it (a codespace or a shared dev box). The same name as
# datyx's, so one setting covers the group.
DATYX_BIND_HOST=127.0.0.1

# Ports: the dashboard keeps datyx's 9906, in the 99xx range (the demos
# have 88xx and 89xx, HealthHub 98xx). FLUTTER_WEB_PORT and API_PORT are
# the names every demo and the repository's start-all.sh use; API_PORT is
# the datyx API's port, which the dashboard proxies to, not a port of its
# own.
FLUTTER_WEB_PORT=9906           # the dashboard, at /app/
API_PORT=9900                   # the datyx API (datyx/), on this host
# Where the API is, when not on this host's API_PORT (a container, another
# machine). The release server and the dev server proxy /api/ and /q/ here.
# DATYX_API_URL=http://127.0.0.1:9900

# How `devbox services up` serves the dashboard (scripts/flutter-web.sh):
#   release the release web build, served by a small native server (built when stale)
#   debug   Flutter's dev server with hot reload (`devbox run web` does this)
WEB_MODE=release

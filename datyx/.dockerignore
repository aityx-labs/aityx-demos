# What the images (docker/*.Dockerfile, built from this folder) get: the
# API's sources and the version files, nothing local or built.
*
!version.X.txt
!version.Y.txt
!scripts/version.sh
!datyx-api/
datyx-api/target/

# BEGIN generated by sync-dockerignore.sh: what git ignores, never in an image
**/.env
**/.env.*
**/target
**/settings.xml
**/*.log
**/logs
**/.devbox
**/.envrc.local
**/build
**/.dart_tool
**/*.iml
**/.idea
**/.DS_Store
**/Thumbs.db
.vscode/*
**/*.local*
**/.claude
# END generated by sync-dockerignore.sh

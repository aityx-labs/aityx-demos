# Local settings. Copy this to .env (gitignored) and fill it in. Every value
# has a default; the services read these from the environment first, then
# from this file (see scripts/infra.sh and scripts/api.sh).

# Where the services listen. 127.0.0.1 keeps them to this machine; set
# 0.0.0.0 to share them (a codespace or a shared dev box).
DATYX_BIND_HOST=127.0.0.1

# Ports: datyx takes 9900 and the 99xx range, so it never collides with the
# demos (88xx and 89xx) or HealthHub (98xx). API_PORT is the name every
# demo and the repository's start-all.sh use; the scripts read it as
# DATYX_API_PORT. The dashboard (datyx-dashboard/, 9906) has its own .env.
API_PORT=9900                   # the datyx API (Quarkus, datyx-api/)
DATYX_DB_PORT=9901              # PostgreSQL
DATYX_OPENMETADATA_PORT=9902    # OpenMetadata UI and API (8585 inside)
DATYX_OPENMETADATA_ADMIN_PORT=9903  # OpenMetadata admin: /healthcheck (8586 inside)
DATYX_SEARCH_PORT=9904          # Elasticsearch, OpenMetadata's index (9200 inside)
DATYX_DEBUG_PORT=9905           # the API's JVM debugger, in dev mode

# PostgreSQL. Development passwords; change them anywhere shared.
DATYX_DB_ADMIN_PASSWORD=postgres        # the postgres superuser
DATYX_DB_PASSWORD=datyx                 # the datyx user, owner of the datyx database
OPENMETADATA_DB_PASSWORD=openmetadata_password  # OpenMetadata's user, owner of openmetadata_db

# How `devbox services up` runs the API (scripts/api.sh):
#   dev     quarkus:dev with live reload and the debugger on DATYX_DEBUG_PORT
#   jar     the packaged API on the GraalVM JDK (built when stale)
#   native  the native executable built by GraalVM native-image (built when stale)
API_MODE=dev
# The configuration profile of the API in Docker (compose.yaml): dev, for
# development, or prod; built into the image, so a change needs
# `docker compose up --build`. API_MODE=dev is always the dev profile;
# jar and native are prod.
DATYX_API_PROFILE=dev

# Authentication: OpenID Connect, Google first. Empty: off, every call is
# anonymous and every path is open. With the client id of the Google OAuth
# client named datyx (Google Cloud project datyx, APIs & Services >
# Credentials; a Web application client with http://localhost:9906 among
# its authorized JavaScript origins), the API wants a signed-in user on
# /api/datasources and /api/me, and the dashboard signs in with it (it
# reads the id from GET /api/auth/config, so nothing is built in). The
# issuer is Google unless another OpenID Connect provider is used.
OIDC_CLIENT_ID=
OIDC_ISSUER=https://accounts.google.com
# Other clients of the same issuer whose tokens this API also accepts:
# HealthHub's client id, so HealthHub's API can pass its user's token on
# unchanged and datyx sees the same person. Comma-separated.
OIDC_EXTRA_AUDIENCES=

# Encryption at rest. The master key that wraps every profile's key, the
# key encrypting the profile's data source access details (hosts, users,
# passwords, keys, paths) in PostgreSQL: 32 bytes in base64, made with
#   openssl rand -base64 32
# Required by the packaged API (API_MODE=jar or native, and Docker); dev
# mode and the tests fall back to a known development key with a warning.
# Keep it: without it nothing encrypted can be read again.
DATYX_MASTER_KEY=

# The catalogue: how the API signs in to OpenMetadata to write the data
# sources' tables and read their tags. A bot's token (OpenMetadata,
# Settings > Bots) when set; else basic authentication, by default the
# stack's built-in admin, admin@open-metadata.org with password admin.
# Change both anywhere shared.
DATYX_OPENMETADATA_TOKEN=
DATYX_OPENMETADATA_EMAIL=admin@open-metadata.org
DATYX_OPENMETADATA_PASSWORD=admin
# OpenMetadata's webhook: where it posts tables' changes (a group switched
# on trains at once), the API as OpenMetadata reaches it; empty, the
# scripts' default (host.docker.internal on the API's port, or the api
# service in Docker Compose). The secret it signs its posts with; empty,
# the API draws one at each start and gives it to OpenMetadata.
DATYX_OPENMETADATA_CALLBACK_URL=
DATYX_OPENMETADATA_WEBHOOK_SECRET=

# aityx (specs/aityx.md): the gateway to aityx at /api/aityx/v1/systemone.
# datyx's aityx key (https://console.aityx.ai), a secret; empty, the
# gateway answers 503. In development the scripts read it, and AITYX_URL,
# from the repository root's .env when this file has none: the key
# HealthHub reads too. Named here commented out, so start-all.sh doesn't
# link this folder's .env to the root's.
# AITYX_API_KEY=
# aityx's base URL; empty, AITYX_URL, else https://api.aityx.ai.
DATYX_AITYX_URL=
# The token services (HealthHub) present instead of signing in, a secret
# (openssl rand -hex 32); empty, service calls are refused. In development
# it is read from the root .env, which HealthHub reads too.
DATYX_SERVICE_TOKEN=
# Whether every profile sees the services' calls (HealthHub's triage,
# health data): empty, yes in dev mode (also a Docker Compose image built
# with the dev profile, the default), no in a packaged (prod) API; true
# only for a single-tenant deployment.
DATYX_AITYX_SHARE_SERVICE_CALLS=

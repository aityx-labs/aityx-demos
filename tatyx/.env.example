# Local settings. Copy this to .env (gitignored) and fill it in; in the
# repository, start-all.sh links this folder's .env to the root one. The
# scripts and the server read these from the environment first, then
# from this file (scripts/env.sh, tatyx_server/server.mjs). Everything
# has a default; the key is optional.

# aityx.ai (https://aityx.ai/docs): keys from the console's API keys
# page, secrets all: only the server reads them. Players bring their own
# keys, set in the app (Profile) and kept in their browser; the server
# never lends one.
#
# The leaderboard's key, staging's: the server's tournaments only. Never
# sent to a browser.
TATYX_LEADERBOARD_KEY=
# The leaderboard's key when TATYX_LEADERBOARD_KEY is unset.
AITYX_API_KEY=
# aityx's base URL, for the players' relay (/aityx/) and the
# leaderboard. Empty:
# https://api.aityx.ai. Staging keys work only on staging:
# AITYX_URL=https://api-stage.aityx.ai
AITYX_URL=
# Production's, for a deployment (none yet): its URL and the
# leaderboard's key, a different one from staging's. A local server
# never reads them.
AITYX_PROD_URL=https://api.aityx.ai
TATYX_PROD_LEADERBOARD_KEY=

# Sign-in: Google, and only these domains' accounts play. The client is a Google OAuth "Web application"
# client of tatyx's Google project (aletyxcode-tatyx, Internal consent
# screen), with http://localhost:9710 among its authorized JavaScript
# origins. Its id is not a secret; its JSON, with the secret nothing here
# needs, is kept in .secrets/ (ignored), mode 600. No id: nobody can sign
# in, and nobody can play.
TATYX_OIDC_CLIENT_ID=
TATYX_ALLOWED_DOMAINS=aletyx.com,aletyx.ai
# Who may start a tournament now, from the leaderboard: the aletyx.com
# and aletyx.ai players, always; no setting.
# Signs the session cookies. Empty: a random one per start (a restart
# signs everyone out).
TATYX_SESSION_SECRET=

# The leaderboard: on (with a key) or off; a tournament every so many
# hours, on the hour in UTC (0: only when an admin asks or a strategy is
# entered); the strategies a player may have in the tour; where the
# results and the entries are kept (empty: tatyx/data/).
TATYX_LEADERBOARD=on
TATYX_LEADERBOARD_EVERY_HOURS=6
TATYX_MAX_ENTRIES=3
TATYX_DATA_DIR=

# The port the server listens on: the app at /app/, the health check at
# /api/health, aityx at /aityx/. The multyx group's range: 9700 is its
# index, 9710 tatyx.
FLUTTER_WEB_PORT=9710
# The address it binds: 127.0.0.1 on a laptop; 0.0.0.0 in a container,
# for the forwarded port to reach it.
TATYX_BIND_HOST=127.0.0.1
